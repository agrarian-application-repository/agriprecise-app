# Copy to .env and fill in. .env is ignored by git: never commit the password.

# --- AGRARIAN PostgreSQL ---
DB_HOST=10.160.101.65
DB_PORT=5432
DB_NAME=agri_precise_db
DB_USER=agri_precise
DB_PASSWORD=
DB_CONNECT_TIMEOUT=5
# 0: test without the database; the rows that would be inserted are written to the log
DB_UPLOAD=1

# --- Receiver ---
ROVER_ID=ROVER_01
# UDP ports of the three streams, the same on the host and in the container
PORT_BASE=5005
PORT_ROVER=5006
PORT_NAV=5007
# A window is processed when the rover buffer holds this many epochs (a stream that never
# pauses)...
ROVER_BUFFER_EPOCHS=360
# ...or after this many seconds without data on any stream (end of a satellite pass)
IDLE_TIMEOUT=60
# auto | raw | base64: auto accepts raw RTCM3 and base64 datagrams alike
PAYLOAD_ENCODING=auto
RTKLIB_CONFIG_FILE=./config/config_rtkpost_ntn.conf
OUTPUT_DIR=/app/output

# Only when replaying an old capture: its start date, "YYYY/MM/DD hh:mm:ss". The sample
# data in data/ was recorded on 2026-07-28. Leave empty with live data.
RTCM_START_TIME=

# --- Anomaly detector ---
# hybrid_engine (csa, ONNX on the CPU if csa fails or takes over 30 s) | csa_engine | onnx_engine
INFERENCE_ENGINE_MODE=hybrid_engine
# Normalisation statistics of the receiver the data comes from. Empty: the default one,
# matching the sample data in data/. The drone dataset needs ./data/drone/data_scaler.json.
ANOMALY_SCALER=
# Host folder with Ubotica's bin/csa, data/nbiot_input/ and data/output/. Empty: ./ubotica
UBOTICA_DIR=
