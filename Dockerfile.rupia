FROM ubuntu:22.04

RUN apt update && apt upgrade -y && \
    apt install -y --no-install-recommends \
        libusb-1.0-0 \
        iputils-ping \
        can-utils \
        build-essential cmake python3 wget gnupg \
        python3-pip libprotobuf-dev protobuf-compiler \
        udev curl tar usbutils && \
    rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --upgrade pip --no-cache-dir && \
    pip3 install --no-cache-dir \
        numpy pyrtcm pandas requests scipy py7zr onnxruntime

WORKDIR /agriprecise_files/
COPY ./agriprecise_files .
